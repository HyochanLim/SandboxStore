<article class="product-item">
  <img src="<%= product.imageUrl %>" alt="<%= product.title %>" />
  <div class="product-item-content">
    <h2><%= product.title %></h2>
    <div>
      <a class = "btn btn-alt" href="/admin/products/<%= product.id %>" data-csrf="<%= locals.csrfToken %>">View & Edit</a>
      <button class="btn btn-alt" data-productid="<%= product.id %>">Delete</button>
    </div>
  </div>
</article>
